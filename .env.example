# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=bookly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookly
POSTGRES_PORT=5432
DATABASE_URL=postgres://bookly:change-me@localhost:5432/bookly?sslmode=disable

# --- App ---
# dev: readable logs, non-Secure cookie. prod: JSON logs, Secure cookie, PUBLIC_URL required.
APP_ENV=dev
PORT=8080
# Public address customers use; goes into WhatsApp messages. e.g. https://book.example.com
PUBLIC_URL=http://localhost:8080
# Built frontend. `make web` builds it here.
WEB_DIR=web/build/dist/js/productionExecutable
# Local numbers (07700 900123) are turned into +44 7700 900123. Leave empty to require +country code.
DEFAULT_COUNTRY_CODE=44
# Set to true only behind a proxy that sets X-Forwarded-For (Fly, Render, Railway, nginx).
TRUST_PROXY=false
WORKER_INTERVAL=30s

# --- WhatsApp via Twilio (optional; without it messages are only logged) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp-enabled Twilio number, e.g. +14155238886 for the sandbox
TWILIO_WHATSAPP_FROM=
# Content SIDs (HX...) of approved WhatsApp templates. Required in production:
# WhatsApp rejects free-form business-initiated messages outside the sandbox.
#   reminder vars: {{1}} name, {{2}} service, {{3}} business, {{4}} date/time, {{5}} manage link
#   review vars:   {{1}} name, {{2}} business, {{3}} review link
TWILIO_REMINDER_CONTENT_SID=
TWILIO_REVIEW_CONTENT_SID=

# --- Your company (legal pages, emails) ---
COMPANY_NAME=Bookly
SUPPORT_EMAIL=

# --- Stripe subscriptions (optional; without them billing is off and every business can take bookings) ---
# Dashboard -> Developers -> API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> endpoint https://YOUR_DOMAIN/api/stripe/webhook
# events: checkout.session.completed, customer.subscription.created/updated/deleted/paused/resumed
STRIPE_WEBHOOK_SECRET=
# Product catalogue -> your plan -> recurring price id (price_...)
STRIPE_PRICE_ID=
# Shown on the homepage and billing page
PRICE_LABEL=£19 / month
TRIAL_DAYS=14

# --- Email over SMTP (optional; without it emails are only logged) ---
# Works with Resend, Postmark, SES, Mailgun, Brevo... 587 = STARTTLS, 465 = TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Bookly <hello@your-domain.com>
