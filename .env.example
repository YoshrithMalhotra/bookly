# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_USER=bookly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookly
POSTGRES_PORT=5432
DATABASE_URL=postgres://bookly:change-me@localhost:5432/bookly?sslmode=disable

# --- App ---
# dev: readable logs, non-Secure cookie. prod: JSON logs, Secure cookie, PUBLIC_URL required.
APP_ENV=dev
PORT=8080
# Public address customers use; goes into WhatsApp messages. e.g. https://book.example.com
PUBLIC_URL=http://localhost:8080
# Built frontend. `make web` builds it here.
WEB_DIR=web/build/dist/js/productionExecutable
# Local numbers (07700 900123) are turned into +44 7700 900123. Leave empty to require +country code.
DEFAULT_COUNTRY_CODE=44
# Set to true only behind a proxy that sets X-Forwarded-For (Fly, Render, Railway, nginx).
TRUST_PROXY=false
WORKER_INTERVAL=30s

# --- WhatsApp via Twilio (optional; without it messages are only logged) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp-enabled Twilio number, e.g. +14155238886 for the sandbox
TWILIO_WHATSAPP_FROM=
# Content SIDs (HX...) of approved WhatsApp templates. Required in production:
# WhatsApp rejects free-form business-initiated messages outside the sandbox.
#   reminder vars: {{1}} name, {{2}} service, {{3}} business, {{4}} date/time, {{5}} manage link
#   review vars:   {{1}} name, {{2}} business, {{3}} review link
TWILIO_REMINDER_CONTENT_SID=
TWILIO_REVIEW_CONTENT_SID=
